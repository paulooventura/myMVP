{
  "name": "mymvp",
  "version": "0.1.0",
  "description": "myMVP — your enthusiastic desktop assistant that fans questions out to GPT, Gemini & Claude, digests the best answer, and actually gets things done on your machine.",
  "main": "./out/main/index.js",
  "author": "PVProductions",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/ensure-electron.mjs",
    "fix:electron": "node scripts/ensure-electron.mjs",
    "dev": "electron-vite dev",
    "dev:web": "vite --config vite.web.config.ts",
    "build": "electron-vite build",
    "build:web": "vite build --config vite.web.config.ts",
    "build:site": "node scripts/build-pauloventura-site.mjs",
    "build:site:wix": "node scripts/build-pauloventura-site.mjs --wix",
    "deploy:wix": "node scripts/deploy-github-pages.mjs --no-cname",
    "deploy:wix:subdomains": "node scripts/deploy-github-pages.mjs",
    "preview": "electron-vite preview",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json"
  },
  "dependencies": {
    "electron-store": "^10.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.0",
    "electron-vite": "^2.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  }
}
